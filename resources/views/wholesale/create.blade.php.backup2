@push('scripts')
<script>
let cart = [];
let itemIndex = 0;
let aksesoriLoaded = false;

// Global search
$('#globalSearch').on('keyup', function() {
    const query = $(this).val().toLowerCase();
    $('.parfum-item, .aksesoris-item').each(function() {
        const name = $(this).data('name');
        $(this).toggle(name.includes(query));
    });
});

// Load aksesori
$('#aksesoris-tab').on('click', function() {
    if (aksesoriLoaded) return;
    
    $('#aksesorisLoading').removeClass('d-none');
    $('#aksesorisGrid').html('');
    
    $.ajax({
        url: @json(route('accessories.search')),
        method: 'GET',
        success: function(data) {
            $('#aksesorisLoading').addClass('d-none');
            if (!data.length) {
                $('#aksesorisGrid').html(`
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                        <p class="text-muted mb-0">Tidak ada aksesori</p>
                    </div>
                `);
                return;
            }
            
            let html = '';
            data.forEach(acc => {
                const badge = acc.current_stock <= 0
                    ? '<span class="badge bg-danger-subtle text-danger" style="font-size: 0.75rem;"><i class="fas fa-times-circle me-1"></i>Habis</span>'
                    : '<span class="badge bg-success-subtle text-success" style="font-size: 0.75rem;"><i class="fas fa-check-circle me-1"></i>Stok: ' + acc.current_stock + ' ' + acc.unit + '</span>';
                
                html += `
                    <div class="col-6 col-md-4 col-lg-2-4 aksesoris-item" data-name="${acc.name.toLowerCase()}">
                        <button type="button" class="btn w-100 text-start product-card ${acc.current_stock <= 0 ? 'disabled' : ''}" 
                            data-accid="${acc.id}" data-name="${acc.name}" data-unit="${acc.unit}" ${acc.current_stock <= 0 ? 'disabled' : ''}>
                            <div class="d-flex flex-column" style="min-height: 80px;">
                                <span class="fw-semibold mb-1" style="font-size: 0.875rem; color: #1e293b; line-height: 1.3;">${acc.name}</span>
                                <div class="mt-auto">${badge}</div>
                            </div>
                        </button>
                    </div>
                `;
            });
            $('#aksesorisGrid').html(html);
            aksesoriLoaded = true;
        },
        error: () => {
            $('#aksesorisLoading').addClass('d-none');
            $('#aksesorisGrid').html('<div class="col-12 text-center py-5 text-danger"><i class="fas fa-exclamation-triangle fa-3x mb-3"></i><p>Gagal memuat</p></div>');
        }
    });
});

// Add to cart - Parfum
$(document).on('click', '.product-card[data-pid]', function() {
    if ($(this).hasClass('disabled')) return;
    
    const pid = $(this).data('pid');
    if (cart.find(i => i.productId === pid)) {
        alert('Produk sudah ada di keranjang!');
        return;
    }
    
    cart.push({
        id: itemIndex++,
        productId: pid,
        accessoryId: null,
        productName: $(this).data('name'),
        stock: $(this).data('stock'),
        volumeMl: 0,
        price: 0,
        unit: 'ml'
    });
    
    renderCart();
});

// Add to cart - Aksesori
$(document).on('click', '.product-card[data-accid]', function() {
    if ($(this).hasClass('disabled')) return;
    
    const accid = $(this).data('accid');
    if (cart.find(i => i.accessoryId === accid)) {
        alert('Aksesori sudah ada di keranjang!');
        return;
    }
    
    cart.push({
        id: itemIndex++,
        productId: null,
        accessoryId: accid,
        productName: $(this).data('name'),
        stock: 0,
        volumeMl: 0,
        price: 0,
        unit: $(this).data('unit')
    });
    
    renderCart();
});

// Render cart
function renderCart() {
    const container = $('#cartItems');
    container.empty();
    
    if (cart.length === 0) {
        container.html(`
            <div id="emptyCart" class="text-center py-5">
                <i class="fas fa-shopping-cart fa-3x text-muted mb-3 d-block"></i>
                <p class="text-muted mb-0">Keranjang kosong</p>
                <small class="text-muted">Pilih produk untuk memulai</small>
            </div>
        `);
        $('#cartCount').text('0');
        $('#btnCheckout').prop('disabled', true);
        updateSummary();
        return;
    }
    
    cart.forEach(item => {
        const stockDisplay = item.stock >= 1000 
            ? (item.stock/1000).toFixed(2) + ' L' 
            : item.stock.toLocaleString('id-ID') + ' ml';
        
        container.append(`
            <div class="cart-item" data-id="${item.id}">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="fw-semibold" style="font-size: 0.9rem; flex: 1;">${item.productName}</span>
                    <button type="button" class="btn btn-sm btn-danger remove-item" data-id="${item.id}" style="padding: 0.25rem 0.5rem;">
                        <i class="fas fa-trash" style="font-size: 0.75rem;"></i>
                    </button>
                </div>
                ${item.stock > 0 ? `<small class="text-muted d-block mb-2">Stok: ${stockDisplay}</small>` : ''}
                <div class="row g-2">
                    <div class="col-6">
                        <input type="number" class="form-control form-control-sm volume-input" data-id="${item.id}" 
                            value="${item.volumeMl}" min="0" placeholder="${item.unit === 'ml' ? 'Volume (ml)' : 'Qty'}" style="font-size: 0.85rem;">
                    </div>
                    <div class="col-6">
                        <input type="number" class="form-control form-control-sm price-input" data-id="${item.id}" 
                            value="${item.price}" min="0" placeholder="Harga (Rp)" style="font-size: 0.85rem;">
                    </div>
                </div>
            </div>
        `);
    });
    
    $('#cartCount').text(cart.length);
    $('#btnCheckout').prop('disabled', false);
    updateSummary();
}

// Update inputs
$(document).on('input', '.volume-input', function() {
    const id = $(this).data('id');
    const item = cart.find(i => i.id === id);
    if (item) {
        item.volumeMl = parseFloat($(this).val()) || 0;
        updateSummary();
    }
});

$(document).on('input', '.price-input', function() {
    const id = $(this).data('id');
    const item = cart.find(i => i.id === id);
    if (item) {
        item.price = parseFloat($(this).val()) || 0;
        updateSummary();
    }
});

// Remove item
$(document).on('click', '.remove-item', function() {
    const id = $(this).data('id');
    cart = cart.filter(i => i.id !== id);
    renderCart();
});

// Update summary
function updateSummary() {
    const total = cart.reduce((sum, item) => sum + item.price, 0);
    $('#grandTotal').text('Rp ' + total.toLocaleString('id-ID'));
}

// Checkout
$('#btnCheckout').on('click', function() {
    if (cart.length === 0) return;
    
    const invalid = cart.filter(i => i.volumeMl <= 0 || i.price <= 0);
    if (invalid.length > 0) {
        alert('Semua item harus memiliki volume/qty dan harga!');
        return;
    }
    
    const hiddenContainer = $('#hiddenItems');
    hiddenContainer.empty();
    cart.forEach((item, idx) => {
        let inputs = `
            <input type="hidden" name="items[${idx}][product_name]" value="${item.productName}">
            <input type="hidden" name="items[${idx}][volume_ml]" value="${item.volumeMl}">
            <input type="hidden" name="items[${idx}][quantity]" value="1">
            <input type="hidden" name="items[${idx}][price]" value="${item.price}">
            <input type="hidden" name="items[${idx}][unit]" value="${item.unit}">
        `;
        if (item.productId) inputs += `<input type="hidden" name="items[${idx}][product_id]" value="${item.productId}">`;
        if (item.accessoryId) inputs += `<input type="hidden" name="items[${idx}][accessory_id]" value="${item.accessoryId}">`;
        hiddenContainer.append(inputs);
    });
    
    $('#checkoutModal').modal('show');
});

// Auto-fill from customer
$('select[name="customer_id"]').on('change', function() {
    const opt = $(this).find('option:selected');
    const phone = opt.data('phone');
    const name = opt.text().split(' (')[0];
    if (name) $('input[name="recipient_name"]').val(name);
    if (phone) $('input[name="recipient_phone"]').val(phone);
});

$(document).ready(function() {
    renderCart();
});
</script>
@endpush
